---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';
import { pageText } from '../data/site';
---
<BaseLayout title="Страница не найдена | СорбентОпт" description="Запрошенная страница не найдена." canonical="/404/" noindex>
  <Header />
  <main id="main-content" class="section"><div class="container narrow"><span class="eyebrow">{pageText('errors.eyebrow', 'Ошибка 404')}</span><h1>{pageText('404.title', 'Страница не найдена')}</h1><p>{pageText('404.body', 'Возможно, адрес изменился. Вернитесь в каталог или на главную страницу.')}</p><a class="button button-primary" href={withBase('/')}>{pageText('errors.homeButton', 'На главную')}</a> <a class="button" href={withBase('/catalog/')}>{pageText('errors.catalogButton', 'Каталог')}</a></div></main>
  <Footer />
</BaseLayout>
