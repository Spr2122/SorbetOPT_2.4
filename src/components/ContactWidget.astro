---
import { CONTACT_CHANNELS } from '../data/site';
---
<div class="contact-widget" id="contact-widget">
  <div class="contact-panel" id="contact-panel" role="dialog" aria-label="Способы связи" hidden>
    <div class="contact-panel-heading">
      <strong>Как удобно связаться?</strong>
      <button type="button" class="contact-panel-close" id="contact-panel-close" aria-label="Закрыть">✕</button>
    </div>
    <ul class="contact-panel-list">
      {CONTACT_CHANNELS.map((channel) => (
        <li>
          <a href={channel.url} target="_blank" rel="noopener" class={`contact-channel contact-channel-${channel.id}`}>
            <span class="contact-channel-icon" aria-hidden="true">
              {channel.id === 'phone' && <svg viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1v3.4c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
              {channel.id === 'telegram' && <svg viewBox="0 0 24 24" fill="none"><path d="M21 4 2.5 11.2c-.9.35-.9 1.63.02 1.96l4.4 1.58 1.7 5.4c.27.86 1.36 1.1 1.97.44l2.5-2.7 4.5 3.35c.75.56 1.83.15 2.02-.77L22 4.9c.2-.9-.72-1.6-1-.9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.9 14.8 18 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>}
              {channel.id === 'whatsapp' && <svg viewBox="0 0 24 24" fill="none"><path d="M4 20l1.3-4.1A8 8 0 1 1 8.9 19L4 20Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 9.3c0 3.8 3 6.7 6.7 6.7.5 0 .9-.5.8-1l-.2-1.1a.8.8 0 0 0-.6-.6l-1.5-.3a.8.8 0 0 0-.8.3l-.4.5a5.6 5.6 0 0 1-2.7-2.7l.5-.4c.2-.2.3-.5.3-.8l-.3-1.5a.8.8 0 0 0-.6-.6L8.5 7.5c-.5-.1-1 .3-1 .8v1Z" fill="currentColor"/></svg>}
              {channel.id === 'max' && <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 16V8.5L12 13l4.5-4.5V16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              {channel.id === 'email' && <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="m4 6.5 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            </span>
            <span class="contact-channel-text"><b>{channel.label}</b><small>{channel.value}</small></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <button type="button" class="contact-toggle" id="contact-toggle" aria-expanded="false" aria-controls="contact-panel" aria-label="Открыть способы связи">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5h16v10H9l-4 3.5v-3.5H4v-10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
  </button>
</div>
<script>
  const widget = document.querySelector('#contact-widget');
  const toggle = document.querySelector('#contact-toggle');
  const panel = document.querySelector('#contact-panel');
  const closeBtn = document.querySelector('#contact-panel-close');

  function openPanel() {
    if (!(panel instanceof HTMLElement) || !(toggle instanceof HTMLElement)) return;
    panel.hidden = false;
    widget?.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
  }
  function closePanel() {
    if (!(panel instanceof HTMLElement) || !(toggle instanceof HTMLElement)) return;
    panel.hidden = true;
    widget?.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
  }
  function togglePanel() {
    if (panel instanceof HTMLElement && panel.hidden) openPanel(); else closePanel();
  }

  toggle?.addEventListener('click', togglePanel);
  closeBtn?.addEventListener('click', closePanel);
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    // Any element marked with .js-open-contact opens this same widget instead of navigating directly.
    const trigger = target.closest('.js-open-contact');
    if (trigger) {
      event.preventDefault();
      openPanel();
      return;
    }
    if (widget instanceof HTMLElement && !widget.contains(target)) closePanel();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closePanel();
  });
</script>
